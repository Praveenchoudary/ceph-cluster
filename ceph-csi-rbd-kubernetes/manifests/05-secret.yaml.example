# Copy this file to 05-secret.yaml, fill in your real values, and NEVER commit that copy.
# 05-secret.yaml is already listed in .gitignore for this reason.
apiVersion: v1
kind: Secret
metadata:
  name: csi-rbd-secret
  namespace: ceph-csi
type: kubernetes.io/opaque
stringData:
  userID: kubernetes
  userKey: <CEPH_USER_KEY>
